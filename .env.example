APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ARTISAN_WEB_TOKEN=
# ARTISAN_PHP_BINARY=/usr/local/bin/php

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_EMULATE_PREPARES=true
# DB_STRINGIFY_FETCHES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
CACHE_LIMITER=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=failover
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_QUEUE_CONNECTION=
MAIL_QUEUE=mail
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_DISK=local
BACKUP_MEDIA_DISK=public
BACKUP_REMOTE_DISK=
BACKUP_RETENTION_DAYS=7
BACKUP_DATABASE_BINARY=mysqldump
BACKUP_DATABASE_TIMEOUT=300
BACKUP_DATABASE_PATH=backups/database
BACKUP_MEDIA_PATH=backups/media
BACKUP_DATABASE_SCHEDULE=02:00
BACKUP_MEDIA_SCHEDULE=02:30
BACKUP_PRUNE_SCHEDULE=03:00

AI_EDITORIAL_ENABLED=false
AI_EDITORIAL_INGEST_ENABLED=false
AI_EDITORIAL_PROVIDER=gemini
AI_EDITORIAL_MODEL=gemini-2.5-flash-lite
AI_EDITORIAL_API_KEY=
AI_EDITORIAL_AUTHOR_EMAIL=
AI_EDITORIAL_MAX_DRAFTS_PER_DAY=10
AI_EDITORIAL_MAX_CALLS_PER_DAY=100
AI_EDITORIAL_MIN_TITLE_LENGTH=18
AI_EDITORIAL_MIN_EXCERPT_LENGTH=40
AI_EDITORIAL_MAX_SOURCE_AGE_HOURS=72
AI_EDITORIAL_INGEST_TIMEOUT=20
AI_EDITORIAL_INGEST_LIMIT=30
AI_EDITORIAL_GENERATION_TIMEOUT=40
AI_EDITORIAL_GENERATION_LIMIT=10
AI_EDITORIAL_GENERATION_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
AI_EDITORIAL_GENERATION_POOL_MULTIPLIER=3
AI_EDITORIAL_MIN_SOURCES_PER_STORY=3
AI_EDITORIAL_MAX_SOURCES_PER_STORY=4
AI_EDITORIAL_MAX_IMAGES_PER_STORY=4
AI_EDITORIAL_MIN_WORD_TARGET=550

VITE_APP_NAME="${APP_NAME}"
